// ── state ────────────────────────────────────────────────────────────────────
const state = {
  edgeTypes: new Set(Object.entries(EDGE_CFG).filter(([,v]) => v.defOn).map(([k]) => k)),
  selected: null, conflictFocus: false, minDegree: 1,
};
let cy, DATA;
const nodeIdByKey = {};
let showcaseSavedPositions = null; // positions saved before concentric layout

// ── helpers ──────────────────────────────────────────────────────────────────
function nodeSize(n, deg) {
  if (n.type === "fund")   return 46;
  if (n.type === "school") return 34;
  if (n.type === "film")   return 12;
  return Math.min(Math.max(10 + Math.sqrt(deg || 0) * 3.5, 12), 42);
}
function nodeColor(n) {
  if (n.type === "fund")   return NODE_COLOR.fund;
  if (n.type === "school") return NODE_COLOR.school;
  if (n.type === "film")   return NODE_COLOR.film;
  return NODE_COLOR.person;
}
function nodeShape(n) {
  if (n.type === "fund")   return "round-rectangle";
  if (n.type === "school") return "round-rectangle";
  if (n.type === "film")   return "diamond";
  return "ellipse";
}

// ── build elements ───────────────────────────────────────────────────────────
function buildElements() {
  const degreeMap = {};
  for (const e of DATA.edges) {
    degreeMap[e.source] = (degreeMap[e.source] || 0) + 1;
    degreeMap[e.target] = (degreeMap[e.target] || 0) + 1;
  }
  const els = [];
  for (const n of DATA.nodes) {
    const deg = n.type === "person" ? (degreeMap[n.id] || 0) : 0;
    const el = { data: {
      id: n.id, label: n.label, ntype: n.type,
      conflict: n.has_strict_conflict ? "strict" : n.has_soft_conflict ? "soft" : "",
      size: nodeSize(n, deg), color: nodeColor(n), shape: nodeShape(n),
      src: n,
    }};
    if (typeof n.x === "number" && typeof n.y === "number") el.position = { x: n.x, y: n.y };
    els.push(el);
  }
  const seen = new Set();
  let i = 0;
  for (const e of DATA.edges) {
    const key = e.source + "|" + e.target + "|" + e.type;
    if (seen.has(key)) continue; seen.add(key);
    const cfg = EDGE_CFG[e.type] || { color: "#444", width: 0.5 };
    let elabel = cfg.label || e.type;
    if (e.film_title) elabel = elabel + ": " + e.film_title + (e.film_year ? " (" + e.film_year + ")" : "");
    else if (e.roles && e.roles.length) elabel = elabel + ": " + e.roles.join(", ");
    els.push({ data: {
      id: "e" + (i++), source: e.source, target: e.target,
      etype: e.type, color: cfg.color, width: cfg.width,
      elabel, roles: (e.roles || []).join(", "), meta: e,
    }});
  }
  return els;
}

// ── cytoscape style ──────────────────────────────────────────────────────────
const CY_STYLE = [
  { selector: "node", style: {
      "background-color": "data(color)",
      "width": "data(size)", "height": "data(size)",
      "shape": "data(shape)",
      "label": "data(label)",
      "color": "#c9d1d9",
      "font-family": "Heebo, sans-serif",
      "font-size": 12,
      "font-weight": 500,
      "text-valign": "center",
      "text-halign": "right",
      "text-margin-x": 5,
      "text-wrap": "none",
      "min-zoomed-font-size": 10,
      "border-width": 0,
      "transition-property": "opacity, border-width",
      "transition-duration": "0.15s",
  }},
  { selector: 'node[ntype = "fund"]', style: {
      "font-size": 22, "font-weight": 700, "color": "#e6edf3", "min-zoomed-font-size": 0,
  }},
  { selector: 'node[ntype = "school"]', style: {
      "font-size": 18, "font-weight": 600, "color": "#e6edf3", "min-zoomed-font-size": 0,
  }},
  { selector: 'node[ntype = "film"]', style: {
      "font-size": 14, "color": "#8b949e", "text-valign": "bottom", "text-margin-y": 5,
      "min-zoomed-font-size": 0, "label": "",
  }},
  { selector: 'node[ntype = "person"]', style: { "label": "" }},
  { selector: 'node.show-labels', style: { "label": "data(label)", "min-zoomed-font-size": 0 }},
  { selector: "edge", style: {
      "width": "data(width)",
      "line-color": "data(color)",
      "curve-style": "straight",
      "opacity": 0.55,
      "transition-property": "opacity",
      "transition-duration": "0.15s",
      "label": "",
  }},
  { selector: ".faded", style: { "opacity": 0.05, "min-zoomed-font-size": 9999 } },
  { selector: "node.hl", style: {
      "border-width": 3, "border-color": "#58a6ff",
      "shadow-blur": 14, "shadow-color": "#58a6ff", "shadow-opacity": 0.7,
      "min-zoomed-font-size": 0, "opacity": 1, "label": "data(label)",
      "font-size": 30, "font-weight": 700, "color": "#ffffff",
      "z-index": 999,
  }},
  { selector: "node.shared-hl", style: {
      "border-width": 2, "border-color": "#f59e0b",
      "shadow-blur": 12, "shadow-color": "#f59e0b", "shadow-opacity": 0.6,
      "opacity": 1, "label": "data(label)", "min-zoomed-font-size": 0,
      "font-size": 24, "font-weight": 700, "color": "#f59e0b",
      "z-index": 998,
  }},
  { selector: "edge.hl", style: {
      "opacity": 1, "width": 3,
      "label": "",
      "z-index": 997,
  }},
  { selector: "edge.shared-edge", style: {
      "opacity": 1, "width": 3,
      "line-color": "#f59e0b",
      "label": "",
      "z-index": 998,
  }},
  { selector: "node.neighbor", style: { "min-zoomed-font-size": 0, "opacity": 0.95, "label": "data(label)", "font-size": 20, "font-weight": 600 } },
  { selector: ".dim-edge",      style: { "display": "none" } },
  { selector: ".cf-dim",        style: { "opacity": 0.04, "min-zoomed-font-size": 9999 } },
  { selector: ".deg-hidden",    style: { "display": "none" } },
  { selector: ".deg-edge-hide", style: { "display": "none" } },
];

// ── init ─────────────────────────────────────────────────────────────────────
function initCy() {
  cy = cytoscape({
    container: document.getElementById("cy"),
    elements: buildElements(),
    style: CY_STYLE,
    layout: { name: "preset" },   // honor baked x/y; runLayout() does fcose only if missing
    minZoom: 0.1, maxZoom: 4,
    wheelSensitivity: 0.25,
    pixelRatio: window.devicePixelRatio || 1,
  });
  applyEdgeFilter();
  runLayout();

  cy.on("tap", "node", evt => selectNode(evt.target));
  cy.on("tap", evt => { if (evt.target === cy) deselect(); });
  cy.on("mouseover", "node", evt => showTooltip(evt.target, evt.renderedPosition));
  cy.on("mousemove", "node", evt => moveTooltip(evt.originalEvent));
  cy.on("mouseout",  "node", hideTooltip);
  cy.on("mouseover", "edge", evt => showEdgeTooltip(evt.target, evt.originalEvent));
  cy.on("mousemove", "edge", evt => moveTooltip(evt.originalEvent));
  cy.on("mouseout",  "edge", hideTooltip);
}

function runLayout() {
  // Positions are precomputed at build time (scripts/precompute_layout.js) and
  // baked into conflict_graph.json — use an instant preset layout. Fall back to
  // live fcose only if positions are missing.
  const hasPreset = cy.nodes().length > 0 &&
    cy.nodes().every(n => { const p = n.position(); return p.x !== 0 || p.y !== 0; });
  if (hasPreset) {
    cy.fit(undefined, 40);
    return;
  }
  const layout = cy.layout({
    name: "fcose",
    quality: "proof",
    animate: false,
    randomize: true,
    nodeRepulsion: 9500,
    idealEdgeLength: e => (e.data("etype") === "institutional" ? 70 : 110),
    edgeElasticity: 0.45,
    gravity: 0.3,
    gravityRange: 3.0,
    nestingFactor: 0.1,
    numIter: 2500,
    nodeSeparation: 90,
    packComponents: true,
  });
  layout.run();
  cy.fit(undefined, 40);
}

// ── edge filter ──────────────────────────────────────────────────────────────
function applyEdgeFilter() {
  cy.batch(() => {
    cy.edges().forEach(e => {
      const on = state.edgeTypes.has(e.data("etype"));
      e.toggleClass("dim-edge", !on);
    });
  });
}

// ── selection ────────────────────────────────────────────────────────────────
function selectNode(node) {
  state.selected = node.id();
  const nb = node.closedNeighborhood();
  const connEdges = node.connectedEdges();
  cy.batch(() => {
    cy.elements().addClass("faded");
    nb.removeClass("faded");
    cy.elements().removeClass("hl neighbor shared-hl shared-edge");
    node.addClass("hl");
    nb.nodes().not(node).addClass("neighbor");
    connEdges.removeClass("dim-edge").addClass("hl");
  });
  if (!showcaseSavedPositions) {
    showcaseSavedPositions = {};
    cy.nodes().forEach(n => { showcaseSavedPositions[n.id()] = { ...n.position() }; });
  }
  // Concentric: selected center → funds/people middle → films outer ring
  // Including films keeps the whole cluster tight so labels stay readable.
  if (nb.nodes().length > 1) {
    nb.layout({
      name: "concentric",
      concentric: n => {
        if (n.id() === node.id()) return 3;
        const t = n.data("src")?.type;
        return t === "film" ? 1 : 2;
      },
      levelWidth: () => 1,
      minNodeSpacing: 35,
      spacingFactor: 1.4,
      avoidOverlap: true,
      fit: false,
      animate: false,
    }).run();
    cy.animate({ fit: { eles: nb, padding: 30 } }, { duration: 500 });
  } else {
    cy.animate({ center: { eles: node }, zoom: 2.0 }, { duration: 400 });
  }
  openDetail(node);
}

function deselect() {
  state.selected = null;
  cy.batch(() => cy.elements().removeClass("faded hl neighbor shared-hl shared-edge"));
  document.querySelectorAll(".showcase-item").forEach(el => el.classList.remove("active-showcase"));
  applyEdgeFilter(); // restore dim-edge on edges temporarily un-dimmed by showcase
  if (showcaseSavedPositions) {
    cy.animate({ positions: showcaseSavedPositions }, { duration: 350 });
    showcaseSavedPositions = null;
  }
  clearDetail();
}

function openDetail(node) {
  document.getElementById("rp-findings-section").style.display = "none";

  const src = node.data("src");
  const badges = [];
  if (src.type === "fund")     badges.push(`<span class="badge-label badge-fund">קרן / מוסד</span>`);
  if (src.type === "school")   badges.push(`<span class="badge-label badge-school">בית ספר</span>`);
  if (src.has_strict_conflict) badges.push(`<span class="badge-label badge-conflict">ניגוד עניינים חריף</span>`);
  if (src.has_soft_conflict)   badges.push(`<span class="badge-label badge-soft">ניגוד עניינים רך</span>`);
  if (!badges.length)          badges.push(`<span class="badge-label badge-person">אדם</span>`);

  // Conflict explanation
  let conflictHtml = "";
  if (src.has_strict_conflict || src.has_soft_conflict) {
    const instFundNames = [], fundedItems = [];
    node.connectedEdges().forEach(edge => {
      const other = edge.source().id() === node.id() ? edge.target() : edge.source();
      if (edge.data("etype") === "institutional") instFundNames.push(other.data("label"));
      if (edge.data("etype") === "film_funded")   fundedItems.push(other.data("label"));
    });
    const severity = src.has_strict_conflict ? "חריף" : "רך";
    const sevColor = src.has_strict_conflict ? "var(--red)" : "var(--orange)";
    const sevIcon  = src.has_strict_conflict ? "⚠" : "⚡";
    const fundStr  = instFundNames.length ? `ב<strong>${instFundNames.slice(0,3).join(", ")}</strong>` : "במוסד";
    const fundedStr = fundedItems.length
      ? ` וגם קיבל מימון מאותה קרן (${fundedItems.length} פרויקטים)`
      : " ובמקביל קיבל מימון";
    conflictHtml = `<div style="background:rgba(248,81,73,.08);border:1px solid rgba(248,81,73,.25);
      border-radius:8px;padding:9px 11px;margin-bottom:10px;direction:rtl;font-size:12px;line-height:1.6">
      <strong style="color:${sevColor}">${sevIcon} ניגוד עניינים ${severity}</strong><br>
      מחזיק תפקיד מוסדי ${fundStr}${fundedStr}.
    </div>`;
  }
  // Derived conflict badges
  if (src.has_derived_conflict) {
    const derivedTypes = [];
    node.connectedEdges().forEach(edge => {
      const et = edge.data("etype");
      if (["critic_committee","family_conflict","collab_committee","festival_committee","lector_filmmaker"].includes(et))
        if (!derivedTypes.includes(et)) derivedTypes.push(et);
    });
    const dcLabels = {
      critic_committee:   "מבקר קולנוע + שופט קרן",
      family_conflict:    "קשר משפחתי עם בעל תפקיד",
      collab_committee:   "שותפי פרויקט בוועדת קרן",
      festival_committee: "מנהל פסטיבל + שופט קרן",
      lector_filmmaker:   "לקטור + יוצר פעיל (דלת מסתובבת)",
    };
    if (derivedTypes.length) {
      const dcStr = derivedTypes.map(t => dcLabels[t] || t).join(" | ");
      conflictHtml += `<div style="background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.3);
        border-radius:8px;padding:9px 11px;margin-bottom:10px;direction:rtl;font-size:12px;line-height:1.6">
        <strong style="color:#f59e0b">🔗 ניגוד עניינים נגזר</strong><br>${dcStr}
      </div>`;
    }
  }

  const groups = {};
  node.connectedEdges().forEach(edge => {
    const other = edge.source().id() === node.id() ? edge.target() : edge.source();
    const etype = edge.data("etype");
    const meta  = edge.data("meta") || {};
    // For family_conflict, determine which source_urls apply to the OTHER node
    const isSource = edge.source().id() === node.id();
    const otherUrls = etype === "family_conflict"
      ? (isSource ? (meta.source_urls_b || []) : (meta.source_urls_a || []))
      : [];
    (groups[etype] = groups[etype] || []).push({ node: other, roles: edge.data("roles"), sourceUrls: otherUrls });
  });

  const ORDER = ["institutional", "lector_filmmaker", "fund_recipient", "critic_committee", "family_conflict", "festival_committee", "film_funded", "affiliated_with", "collab_committee", "crew_credit", "collaborated_with", "co_credited"];
  let conns = "";
  for (const etype of ORDER) {
    if (!groups[etype]?.length) continue;
    const cfg = EDGE_CFG[etype] || { label: etype, color: "#888" };
    const items = groups[etype].slice(0, 40);
    conns += `<div class="conn-section"><div class="conn-title">${cfg.label} <span class="conn-count">${groups[etype].length}</span></div>`;
    for (const { node: other, roles, sourceUrls } of items) {
      const id = other.id();
      const key = btoa(encodeURIComponent(id)).replace(/[^a-zA-Z0-9]/g, "_");
      nodeIdByKey[key] = id;
      const validUrls = (sourceUrls || []).filter(u => u.startsWith("http")).slice(0, 2);
      const srcLinks = validUrls.map((u, i) =>
        `<a href="${u}" target="_blank" style="font-size:10px;color:#f59e0b;text-decoration:none;margin-inline-start:4px">מקור ${i + 1} ↗</a>`
      ).join("");
      const verifyNote = etype === "family_conflict"
        ? `<span style="font-size:9px;color:#6b7280;margin-inline-start:4px">⚠ נדרש אימות</span>` : "";
      conns += `<div class="conn-item" data-nkey="${key}">
        <span class="conn-cdot" style="background:${cfg.color}"></span>
        <span class="conn-text"><div class="conn-name">${other.data("label")}${srcLinks}${verifyNote}</div>
        ${roles ? `<div class="conn-role">${roles}</div>` : ""}</span></div>`;
    }
    conns += "</div>";
  }

  document.getElementById("rp-detail").innerHTML = `
    <div class="person-card">
      <h3>${node.data("label")}</h3>
      <div class="badges">${badges.join("")}</div>
      ${conflictHtml}
      ${conns || `<div style="color:var(--text-dim);font-size:12px">אין קשרים</div>`}
    </div>`;
  document.getElementById("rp-detail").querySelectorAll("[data-nkey]").forEach(el =>
    el.addEventListener("click", () => jumpTo(nodeIdByKey[el.dataset.nkey])));
}

function clearDetail() {
  document.getElementById("rp-findings-section").style.display = "";
  document.getElementById("rp-detail").innerHTML = `<div id="rp-detail-empty">לחצו על צומת בגרף לצפייה בפרטים</div>`;
}

function jumpTo(id) {
  const node = cy.$id(id);
  if (!node.length) return;
  cy.animate({ center: { eles: node }, zoom: 1.6 }, { duration: 400 });
  selectNode(node);
}

function highlightShowcase(i) {
  const s = SHOWCASES[i];

  document.querySelectorAll(".showcase-item").forEach((el, j) =>
    el.classList.toggle("active-showcase", j === i));

  const nodeIdSet = new Set(s.nodes);
  const targets = cy.nodes().filter(n => nodeIdSet.has(n.id()));
  if (!targets.length) return;

  // Merge any showcase-specific edge types into the effective set
  const effectiveEdgeTypes = new Set(state.edgeTypes);
  if (s.enableEdgeTypes) s.enableEdgeTypes.forEach(t => effectiveEdgeTypes.add(t));

  // Count how many target nodes each neighbor touches (all edge types)
  const targetIds = new Set(targets.map(n => n.id()));
  const neighborCount = {};
  targets.forEach(n => {
    n.connectedEdges().forEach(e => {
      const otherId = e.source().id() === n.id() ? e.target().id() : e.source().id();
      if (!targetIds.has(otherId))
        neighborCount[otherId] = (neighborCount[otherId] || 0) + 1;
    });
  });

  // Single-node showcases: ALL neighbors become gold (full 1-hop star)
  // Multi-node showcases: only nodes connected to 2+ targets (shared hubs)
  const minCount = targets.length === 1 ? 1 : 2;
  const sharedIds = new Set(
    Object.entries(neighborCount).filter(([, c]) => c >= minCount).map(([id]) => id)
  );
  const sharedNodes = cy.nodes().filter(n => sharedIds.has(n.id()));

  state.selected = targets.first().id();
  cy.batch(() => {
    cy.elements().addClass("faded").removeClass("hl neighbor shared-hl shared-edge");

    targets.removeClass("faded").addClass("hl");
    sharedNodes.removeClass("faded").addClass("shared-hl");

    targets.forEach(n => {
      n.connectedEdges().forEach(e => {
        const otherId = e.source().id() === n.id() ? e.target().id() : e.source().id();
        const other = e.source().id() === n.id() ? e.target() : e.source();

        // Make edge visible even if it was dim-edge (hidden by filter)
        e.removeClass("dim-edge");

        if (sharedIds.has(otherId)) {
          e.addClass("shared-edge").removeClass("faded");
        } else if (targetIds.has(otherId)) {
          e.addClass("hl").removeClass("faded");
        } else {
          e.removeClass("faded");
          other.removeClass("faded").addClass("neighbor");
        }
      });
    });
  });

  // Save current positions so deselect() can restore them
  const storyGraph = targets.union(sharedNodes);
  showcaseSavedPositions = {};
  storyGraph.nodes().forEach(n => { showcaseSavedPositions[n.id()] = { ...n.position() }; });

  // Layout: target at center, neighbors in a tight ring
  storyGraph.layout({
    name: "concentric",
    concentric: n => targetIds.has(n.id()) ? 2 : 1,
    levelWidth: () => 1,
    minNodeSpacing: 40,
    spacingFactor: 1.5,
    avoidOverlap: true,
    fit: false,
    animate: false,
  }).run();
  cy.animate({ fit: { eles: storyGraph, padding: 40 } }, { duration: 500 });

  openDetail(targets.first());
}

// ── search ───────────────────────────────────────────────────────────────────
function initSearch() {
  const input = document.getElementById("search");
  const dd = document.getElementById("search-dropdown");
  input.addEventListener("input", () => {
    const q = input.value.trim();
    if (!q) { dd.style.display = "none"; return; }
    const res = cy.nodes().filter(n => n.data("label").includes(q)).toArray().slice(0, 20);
    if (!res.length) { dd.style.display = "none"; return; }
    dd.innerHTML = res.map((n, i) => {
      const key = "ss_" + i; nodeIdByKey[key] = n.id();
      return `<div class="sd-item" data-nkey="${key}">
        <span class="sd-dot" style="background:${n.data("color")}"></span>
        <span class="sd-label">${n.data("label")}</span></div>`;
    }).join("");
    dd.querySelectorAll("[data-nkey]").forEach(el =>
      el.addEventListener("click", () => { dd.style.display = "none"; input.value = ""; jumpTo(nodeIdByKey[el.dataset.nkey]); }));
    dd.style.display = "block";
  });
  input.addEventListener("keydown", e => { if (e.key === "Escape") { dd.style.display = "none"; input.blur(); } });
  document.addEventListener("click", e => {
    if (!document.getElementById("search-wrap").contains(e.target)) dd.style.display = "none";
  });
}

// ── filters ──────────────────────────────────────────────────────────────────
function buildEdgeFilters() {
  const counts = {};
  cy.edges().forEach(e => counts[e.data("etype")] = (counts[e.data("etype")] || 0) + 1);
  const wrap = document.getElementById("edge-filters");
  wrap.innerHTML = Object.entries(EDGE_CFG).filter(([k]) => counts[k]).map(([key, cfg]) => `
    <button class="filter-btn ${cfg.defOn ? "active" : ""}" data-etype="${key}">
      <span class="fbtn-dot" style="background:${cfg.color}"></span>${cfg.label}
    </button>`).join("");
  wrap.querySelectorAll(".filter-btn[data-etype]").forEach(btn =>
    btn.addEventListener("click", () => {
      const on = !btn.classList.contains("active");
      btn.classList.toggle("active", on);
      on ? state.edgeTypes.add(btn.dataset.etype) : state.edgeTypes.delete(btn.dataset.etype);
      applyEdgeFilter();
      if (state.selected) selectNode(cy.$id(state.selected));
    }));
}

// ── legend ───────────────────────────────────────────────────────────────────
function buildLegend() {
  const counts = {};
  DATA.nodes.forEach(n => {
    const k = n.type === "fund" ? "fund" : n.type === "school" ? "school"
            : n.type === "film" ? "film"
            : n.has_strict_conflict ? "conflict" : n.has_soft_conflict ? "soft"
            : n.has_derived_conflict ? "derived" : "person";
    counts[k] = (counts[k] || 0) + 1;
  });
  const totalPeople = (counts.conflict || 0) + (counts.soft || 0) + (counts.derived || 0) + (counts.person || 0);
  document.getElementById("node-legend").innerHTML = `
    <div class="legend-item"><span class="lg-dot" style="background:#f78166"></span><span style="flex:1">אנשים (גודל = קשרים)</span><span>${totalPeople}</span></div>
    <div class="legend-item"><span class="lg-sq" style="background:#58a6ff"></span><span style="flex:1">קרן / מוסד</span><span>${counts.fund || 0}</span></div>
    <div class="legend-item"><span class="lg-sq" style="background:#bc8cff"></span><span style="flex:1">בית ספר</span><span>${counts.school || 0}</span></div>
    <div class="legend-item"><span style="width:10px;height:10px;background:#4a3728;transform:rotate(45deg);flex-shrink:0;display:inline-block"></span><span style="flex:1;margin-right:3px">סרט</span><span>${counts.film || 0}</span></div>`;
  document.getElementById("edge-legend").innerHTML = Object.entries(EDGE_CFG).map(([, cfg]) => `
    <div class="legend-item"><span class="lg-line" style="background:${cfg.color}"></span><span>${cfg.label}</span></div>`).join("");
}

// ── stats / findings ─────────────────────────────────────────────────────────
function buildStats() {
  const strict   = DATA.nodes.filter(n => n.has_strict_conflict).length;
  const soft     = DATA.nodes.filter(n => n.has_soft_conflict).length;
  const derived  = DATA.nodes.filter(n => n.has_derived_conflict && !n.has_strict_conflict && !n.has_soft_conflict).length;
  const funds    = DATA.nodes.filter(n => n.type === "fund").length;
  const schools  = DATA.nodes.filter(n => n.type === "school").length;
  const films    = DATA.nodes.filter(n => n.type === "film").length;
  const inst     = DATA.edges.filter(e => e.type === "institutional").length;
  const dcEdges  = DATA.edges.filter(e =>
    ["critic_committee","family_conflict","collab_committee","festival_committee","lector_filmmaker"].includes(e.type)
  ).length;

  document.getElementById("stats-cards").innerHTML = `
    <div class="stat red"><div class="num">${strict}</div><div class="lbl">ניגוד חריף</div></div>
    <div class="stat orange"><div class="num">${soft}</div><div class="lbl">ניגוד רך</div></div>
    <div class="stat" style="--accent:#f59e0b"><div class="num" style="color:#f59e0b">${derived}</div><div class="lbl">ניגוד נגזר</div></div>
    <div class="stat blue"><div class="num">${funds}</div><div class="lbl">קרנות</div></div>
    <div class="stat"><div class="num">${schools}</div><div class="lbl">בתי ספר</div></div>
    <div class="stat"><div class="num">${films}</div><div class="lbl">סרטים</div></div>
    <div class="stat"><div class="num">${inst}</div><div class="lbl">קשרים מוסדיים</div></div>
    <div class="stat"><div class="num">${dcEdges}</div><div class="lbl">קשרים נגזרים</div></div>`;

  const byCat = {};
  SHOWCASES.forEach((s, i) => {
    const c = s.category || "other";
    (byCat[c] = byCat[c] || []).push({ s, i });
  });
  let showcaseHtml = "";
  for (const cat of SHOWCASE_CATEGORIES) {
    const items = byCat[cat.id];
    if (!items?.length) continue;
    showcaseHtml += `<div class="sec-title" style="margin-top:10px;margin-bottom:4px">${cat.label}</div>`;
    showcaseHtml += `<div class="showcase-list">` + items.map(({ s, i }) => `
      <div class="showcase-item" onclick="highlightShowcase(${i})" title="לחצו להדגשה בגרף">
        <span class="showcase-tag">${s.tag}</span>
        <span class="showcase-name">${s.label}</span>
        <span class="showcase-desc">${s.desc}</span>
      </div>`).join("") + `</div>`;
  }
  document.getElementById("rp-findings").innerHTML = `
    <div class="sec-title">ניגודי עניינים — לחצו להדגשה בגרף</div>
    ${showcaseHtml}`;
}

function updateHeaderStats() {
  document.getElementById("header-stats").textContent =
    `${DATA.nodes.length} צמתים · ${DATA.edges.length} קשרים · תצוגת ניגודי עניינים`;
}

// ── tooltip ──────────────────────────────────────────────────────────────────
const tooltip = document.getElementById("tooltip");
const TYPE_LABEL = { person: "אדם", fund: "קרן / מוסד", school: "בית ספר / אקדמיה", film: "סרט" };
function showTooltip(node, pos) {
  const src = node.data("src");
  let conflict = "";
  if (src.has_strict_conflict) conflict = `<div class="tt-conflict">⚠ ניגוד עניינים חריף</div>`;
  else if (src.has_soft_conflict) conflict = `<div class="tt-conflict" style="color:var(--orange)">ניגוד עניינים רך</div>`;
  tooltip.innerHTML = `<div class="tt-title">${node.data("label")}</div>
    <div class="tt-type">${TYPE_LABEL[src.type] || src.type} · ${node.degree()} קשרים</div>${conflict}`;
  tooltip.style.display = "block";
}
function showEdgeTooltip(edge, ev) {
  const meta  = edge.data("meta") || {};
  const etype = edge.data("etype");
  const cfg   = EDGE_CFG[etype] || { label: etype, color: "#888" };
  const src   = edge.source().data("label");
  const tgt   = edge.target().data("label");

  let detail = "";
  if (meta.roles && meta.roles.length)  detail += `<div class="tt-type">תפקיד: ${meta.roles.join(", ")}</div>`;
  if (meta.film_title)                  detail += `<div class="tt-type">סרט: ${meta.film_title}${meta.film_year ? " (" + meta.film_year + ")" : ""}</div>`;
  if (meta.crew_role)                   detail += `<div class="tt-type">תפקיד בסרט: ${meta.crew_role}</div>`;
  if (meta.rd_type === "simultaneous")  detail += `<div class="tt-conflict" style="color:var(--orange)">⚡ בו-זמנית</div>`;

  // Source links for family/derived conflict edges
  if (etype === "family_conflict") {
    const srcLabel = edge.source().data("label");
    const tgtLabel = edge.target().data("label");
    const urlsA = (meta.source_urls_a || []).filter(u => u.startsWith("http")).slice(0, 2);
    const urlsB = (meta.source_urls_b || []).filter(u => u.startsWith("http")).slice(0, 2);
    if (urlsA.length || urlsB.length) {
      detail += `<div class="tt-type" style="margin-top:5px;border-top:1px solid rgba(255,255,255,.1);padding-top:5px">מקורות:</div>`;
      urlsA.forEach(u => detail += `<div class="tt-type"><a href="${u}" target="_blank" style="color:#f59e0b;font-size:10px">${srcLabel} ↗</a></div>`);
      urlsB.forEach(u => detail += `<div class="tt-type"><a href="${u}" target="_blank" style="color:#f59e0b;font-size:10px">${tgtLabel} ↗</a></div>`);
    }
    detail += `<div class="tt-type" style="margin-top:4px;color:#6b7280;font-size:10px">⚠ זיהוי אלגוריתמי — נדרש אימות</div>`;
  }

  tooltip.innerHTML = `
    <div class="tt-title" style="color:${cfg.color}">${cfg.label}</div>
    <div class="tt-type" style="direction:rtl">${src} ↔ ${tgt}</div>
    ${detail}`;
  tooltip.style.display = "block";
  if (ev) moveTooltip(ev);
}
function hideTooltip() { tooltip.style.display = "none"; }
function moveTooltip(ev) {
  if (!ev) return;
  tooltip.style.left = (ev.clientX + 14) + "px";
  tooltip.style.top  = (ev.clientY - 8) + "px";
}

// ── zoom ─────────────────────────────────────────────────────────────────────
function initZoom() {
  document.getElementById("btn-zi").onclick = () => cy.animate({ zoom: cy.zoom() * 1.4, center: { eles: cy.elements() } }, { duration: 150 });
  document.getElementById("btn-zo").onclick = () => cy.animate({ zoom: cy.zoom() / 1.4, center: { eles: cy.elements() } }, { duration: 150 });
  document.getElementById("btn-fit").onclick = () => cy.animate({ fit: { padding: 40 } }, { duration: 250 });
}

// ── display controls ─────────────────────────────────────────────────────────
const display = { labels: false, films: true };

function applyConflictFocus(active) {
  cy.batch(() => {
    if (!active) {
      cy.elements().removeClass("cf-dim");
      return;
    }
    const conflictNodes = cy.nodes().filter(n => {
      const s = n.data("src") || {};
      return s.has_strict_conflict || s.has_soft_conflict;
    });
    const relEdges = conflictNodes.connectedEdges(
      '[etype = "institutional"],[etype = "film_funded"]'
    );
    const visible = conflictNodes.union(relEdges).union(relEdges.connectedNodes());
    cy.elements().addClass("cf-dim");
    visible.removeClass("cf-dim");
  });
}

function applyDegreeFilter() {
  const min = state.minDegree;
  cy.batch(() => {
    cy.nodes().forEach(n => {
      const src = n.data("src") || {};
      if (src.type !== "person") { n.removeClass("deg-hidden"); return; }
      n.toggleClass("deg-hidden", n.degree() < min);
    });
    cy.edges().forEach(e => {
      e.toggleClass("deg-edge-hide",
        e.source().hasClass("deg-hidden") || e.target().hasClass("deg-hidden")
      );
    });
  });
}

function initControls() {
  const btnLabels  = document.getElementById("ctrl-labels");
  const btnFilms   = document.getElementById("ctrl-films");
  const btnFocus   = document.getElementById("ctrl-conflict-focus");
  const degVal     = document.getElementById("ctrl-deg-val");
  const btnDegDn   = document.getElementById("ctrl-deg-dn");
  const btnDegUp   = document.getElementById("ctrl-deg-up");

  btnLabels.addEventListener("click", () => {
    display.labels = !display.labels;
    btnLabels.classList.toggle("active", display.labels);
    cy.nodes('[ntype = "person"], [ntype = "film"]').toggleClass("show-labels", display.labels);
  });

  btnFilms.addEventListener("click", () => {
    display.films = !display.films;
    btnFilms.classList.toggle("active", display.films);
    cy.batch(() => {
      const filmNodes = cy.$('node[ntype = "film"]');
      filmNodes.style("display", display.films ? "element" : "none");
      filmNodes.connectedEdges().style("display", display.films ? "element" : "none");
    });
  });

  btnFocus.addEventListener("click", () => {
    state.conflictFocus = !state.conflictFocus;
    btnFocus.classList.toggle("active", state.conflictFocus);
    applyConflictFocus(state.conflictFocus);
    // If a node was selected while turning off focus, restore highlight
    if (!state.conflictFocus && state.selected) selectNode(cy.$id(state.selected));
  });

  function updateDegree(delta) {
    const next = Math.max(1, Math.min(15, state.minDegree + delta));
    if (next === state.minDegree) return;
    state.minDegree = next;
    degVal.textContent = next;
    degVal.style.color = next > 1 ? "var(--accent)" : "var(--text)";
    btnDegDn.disabled = next <= 1;
    applyDegreeFilter();
    // Re-highlight if selection is active
    if (state.selected) {
      const n = cy.$id(state.selected);
      if (n.hasClass("deg-hidden")) deselect();
      else selectNode(n);
    }
  }
  btnDegDn.addEventListener("click", () => updateDegree(-1));
  btnDegUp.addEventListener("click", () => updateDegree(+1));
}

// ── boot ─────────────────────────────────────────────────────────────────────
async function boot() {
  const msg = document.getElementById("loading-msg");
  try {
    msg.textContent = "טוען נתונים...";
    const res = await fetch("conflict_graph.json");
    if (!res.ok) throw new Error(`HTTP ${res.status} — הפעל: python3 -m http.server 8000`);
    DATA = await res.json();

    msg.textContent = "בונה רשת קשרים...";
    await new Promise(r => setTimeout(r, 30));
    initCy();
    buildEdgeFilters();
    buildLegend();
    buildStats();
    updateHeaderStats();
    initSearch();
    initZoom();
    initControls();

    document.getElementById("loading").classList.add("hidden");
  } catch (err) {
    console.error("boot error:", err);
    msg.textContent = String(err);
    msg.style.color = "#f85149";
  }
}
boot();
</script>
</body>
</html>
